{
  "family": "notesai-task",
  "requiresCompatibilities": [
    "EC2"
  ],
  "networkMode": "bridge",
  "memory": "4096",
  "cpu": "2048",
  "executionRoleArn": "arn:aws:iam::036230293894:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::036230293894:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "036230293894.dkr.ecr.ap-south-1.amazonaws.com/notesai-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql+asyncpg://postgres:1234@postgres:5432/notesai"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "kafka:9092"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "shared_storage",
          "containerPath": "/app/storage",
          "readOnly": false
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "backend",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "ocr_service",
      "image": "036230293894.dkr.ecr.ap-south-1.amazonaws.com/notesai-ocr:latest",
      "essential": true,
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql+asyncpg://postgres:1234@postgres:5432/notesai"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "kafka:9092"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "shared_storage",
          "containerPath": "/app/storage"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ocr",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "ai_formatter",
      "image": "036230293894.dkr.ecr.ap-south-1.amazonaws.com/notesai-ai:latest",
      "essential": true,
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql+asyncpg://postgres:1234@postgres:5432/notesai"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "kafka:9092"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "shared_storage",
          "containerPath": "/app/storage"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ai",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "pdf_formatter",
      "image": "036230293894.dkr.ecr.ap-south-1.amazonaws.com/notesai-pdf:latest",
      "essential": true,
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql+asyncpg://postgres:1234@postgres:5432/notesai"
        },
        {
          "name": "KAFKA_BOOTSTRAP_SERVERS",
          "value": "kafka:9092"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "shared_storage",
          "containerPath": "/app/storage"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "pdf",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "frontend",
      "image": "036230293894.dkr.ecr.ap-south-1.amazonaws.com/notesai-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "frontend",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "postgres",
      "image": "postgres:16",
      "essential": true,
      "environment": [
        {
          "name": "POSTGRES_USER",
          "value": "postgres"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "1234"
        },
        {
          "name": "POSTGRES_DB",
          "value": "notesai"
        }
      ],
      "portMappings": [
        {
          "containerPort": 5432,
          "hostPort": 5432,
          "protocol": "tcp"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "shared_storage",
          "containerPath": "/var/lib/postgresql/data"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "postgres",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "zookeeper",
      "image": "confluentinc/cp-zookeeper:7.4.0",
      "essential": true,
      "environment": [
        {
          "name": "ZOOKEEPER_CLIENT_PORT",
          "value": "2181"
        }
      ],
      "portMappings": [
        {
          "containerPort": 2181,
          "hostPort": 2181,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "zookeeper",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "kafka",
      "image": "confluentinc/cp-kafka:7.4.0",
      "essential": true,
      "environment": [
        {
          "name": "KAFKA_BROKER_ID",
          "value": "1"
        },
        {
          "name": "KAFKA_ZOOKEEPER_CONNECT",
          "value": "zookeeper:2181"
        },
        {
          "name": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP",
          "value": "PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT"
        },
        {
          "name": "KAFKA_LISTENERS",
          "value": "PLAINTEXT://0.0.0.0:9092,PLAINTEXT_HOST://0.0.0.0:29092"
        },
        {
          "name": "KAFKA_ADVERTISED_LISTENERS",
          "value": "PLAINTEXT://kafka:9092,PLAINTEXT_HOST://localhost:29092"
        },
        {
          "name": "KAFKA_INTER_BROKER_LISTENER_NAME",
          "value": "PLAINTEXT"
        },
        {
          "name": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR",
          "value": "1"
        }
      ],
      "portMappings": [
        {
          "containerPort": 9092,
          "hostPort": 9092,
          "protocol": "tcp"
        },
        {
          "containerPort": 29092,
          "hostPort": 29092,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "kafka",
          "awslogs-create-group": "true"
        }
      }
    },
    {
      "name": "db-init",
      "image": "036230293894.dkr.ecr.ap-south-1.amazonaws.com/notesai-backend:latest",
      "essential": false,
      "command": [
        "alembic",
        "upgrade",
        "head"
      ],
      "environment": [
        {
          "name": "DATABASE_URL",
          "value": "postgresql+asyncpg://postgres:1234@postgres:5432/notesai"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/notesai",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "db-init",
          "awslogs-create-group": "true"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "shared_storage",
      "host": {
        "sourcePath": "/mnt/ebs_data/storage"
      }
    }
  ]
}